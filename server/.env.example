# Copy to server/.env and fill in. Start with:  node --env-file=server/.env server/server.js
# Never commit the filled-in .env — it is gitignored.

# Required: the password for http://localhost:8080/admin
ADMIN_PASSWORD=change-me

# Optional
PORT=8080
DB_PATH=server/data.db

# Only needed if the website is hosted somewhere else than this API
# ALLOW_ORIGIN=https://myfinancialria.github.io

# Optional: get told when an enquiry arrives (either, both, or neither)
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=google-app-password-not-your-account-password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com
